# AWS Production Environment Variables

# Database Configuration (AWS RDS MySQL)
DATABASE_URL=jdbc:mysql://your-rds-endpoint.region.rds.amazonaws.com:3306/teamit?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_USERNAME=admin
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_production_jwt_secret_key_minimum_256_bits
JWT_EXPIRATION_ACCESS=3600000
JWT_EXPIRATION_REFRESH=604800000

# DDL Auto (validate for production, update for initial setup)
DDL_AUTO=validate

# Application Port (optional, defaults to 8080)
PORT=8080
